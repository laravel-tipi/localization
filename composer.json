{
    "name": "laravel-tipi/localization",
    "description": "Localization and localized routing for Laravel.",
    "keywords": [
        "laravel",
        "localization",
        "locale",
        "i18n",
        "routing"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Irakli",
            "email": "iraklikevkhishvili@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "laravel-tipi/support": "^1.0",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
      "ext-intl": "*"
    },
    "autoload": {
        "psr-4": {
            "Tipi\\Localization\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tipi\\Localization\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tipi\\Localization\\LocalizationServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint",
        "format:test": "pint --test",
        "check": [
            "@format:test",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "support": {
        "issues": "https://github.com/laravel-tipi/localization/issues",
        "source": "https://github.com/laravel-tipi/localization"
    }
}
