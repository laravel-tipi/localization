{
    "name": "laravel-tipi/localization",
    "description": "Localization and localized routing for Laravel.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Irakli",
            "email": "iraklikevkhishvili@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Tipi\\Localization\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tipi\\Localization\\Tests\\": "tests/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tipi\\Localization\\LocalizationServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
